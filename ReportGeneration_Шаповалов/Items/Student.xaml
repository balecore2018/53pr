<UserControl x:Class="ReportGeneration_Шаповалов.Items.Student"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="170">
    <Border Margin="0,0,0,10"
            Padding="18"
            Background="White"
            BorderBrush="#d9e2ec"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Width="104"
                   Height="104"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                       Source="/Images/ic_student.png"
                       Stretch="Uniform" />

            <StackPanel Grid.Column="1"
                        Margin="18,0,0,0">
                <TextBox x:Name="FullNameText"
                         Height="30"
                         Padding="7,3"
                         FontSize="16"
                         IsReadOnly="True" />
                <CheckBox x:Name="ExpelledCheck"
                          Margin="0,8,0,0"
                          Content="Отчислен"
                          IsEnabled="False" />
                <TextBlock Margin="0,14,0,6"
                           Text="Выполненные работы:" />
                <ProgressBar x:Name="WorksProgress"
                             Height="30"
                             Maximum="100"
                             Foreground="#08b536"
                             Background="#e6e6e6" />
                <TextBlock Margin="0,16,0,6"
                           Text="Посещаемость:" />
                <ProgressBar x:Name="AttendanceProgress"
                             Height="30"
                             Maximum="100"
                             Foreground="#08b536"
                             Background="#e6e6e6" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
